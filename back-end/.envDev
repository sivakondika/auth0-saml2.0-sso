PORT=3000
BASE_URL=http://localhost:3000

# The SP Entity ID / SAML issuer.
SAML_ISSUER=http://localhost:3000/saml/metadata

# Auth0 SAML2 Web App -> Usage -> Identity Provider Login URL
SAML_ENTRY_POINT=Identity Provider Login URL Here

# PEM certificate downloaded from Auth0.
SAML_IDP_CERT_PATH=./config/auth0-idp-cert.pem

# Change this for your local demo.
SESSION_SECRET=mySuperSecretLocalDemoKey123
